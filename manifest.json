{
  "manifest_version": 3,
  "name": "Affine Tango",
  "version": "0.1.0",
  "description": "Solves LinkedIn's Tango puzzle live and animates the derivation.",
  "permissions": ["storage", "debugger"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "host_permissions": [
    "https://8tango.com/*",
    "https://www.8tango.com/*",
    "https://www.linkedin.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/extension/popup.html",
    "default_title": "Affine Tango",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["dist/live-harness.html"],
      "matches": ["https://8tango.com/*", "https://www.8tango.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://8tango.com/*",
        "https://www.8tango.com/*"
      ],
      "js": ["dist/8tango-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.linkedin.com/games/tango*",
        "https://8tango.com/*",
        "https://www.8tango.com/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
